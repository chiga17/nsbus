# Copy to server/.env for a local run.
# On the droplet, put the same keys in /etc/nsbus.env (chmod 600) and load that
# file from systemd. Never commit real values. This repository is public.

# {station_uid} is replaced for each stop.
NSMART_API_URL=https://online.nsmart.rs/publicapi/v1/announcement/announcement.php?ibfm=TM00000&station_uid={station_uid}
NSMART_AUTH_HEADER=
NSMART_AUTH_VALUE=

# Token our own clients must send: Authorization: Bearer <token>
CLIENT_TOKEN=

# Comma-separated line ids. Empty means every line in server/stops.json.
LINES=1A,5B,6A

POLL_SECONDS=30
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# Set on the droplet when the process should listen for other machines.
# HOST=0.0.0.0

# Comma-separated browser origins allowed to call /buses.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
