# Secret URL path for the admin page, set in the Cloudflare Pages build environment.
# Not committed. At least 16 letters, numbers, "_" or "-".
# Leave empty to publish the map with no admin page.
ADMIN_PATH=

# Used only by the admin page. Not included in the public map bundle.
# Locally this can be /buses; the dev server proxies that to the Python backend.
# On Cloudflare Pages set the public backend URL, for example https://buses.example.com/buses.
VITE_BUSES_URL=
VITE_BUSES_TOKEN=
